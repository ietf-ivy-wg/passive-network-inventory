module: ietf-nwi-passive-inventory

  augment /nwi:network-inventory:
    +--ro cable* [id]
    |  +--ro id               string
    |  +--ro length?          uint32
    |  +--ro a-end
    |  |  +--ro device-type?           identityref
    |  |  +--ro (connected-device-type)?
    |  |     +--:(passive)
    |  |     |  +--ro device-id?       string
    |  |     +--:(active)
    |  |        +--ro ne-ref?          leafref
    |  |        +--ro component-ref?   leafref
    |  +--ro z-end
    |  |  +--ro device-type?           identityref
    |  |  +--ro (connected-device-type)?
    |  |     +--:(passive)
    |  |     |  +--ro device-id?       string
    |  |     +--:(active)
    |  |        +--ro ne-ref?          leafref
    |  |        +--ro component-ref?   leafref
    |  +--ro uuid?            yang:uuid
    |  +--ro name?            string
    |  +--ro alias?           string
    |  +--ro description?     string
    |  +--ro cable-type?      identityref
    |  +--ro cable-role?      identityref
    |  +--ro optical-cable
    |  |  +--ro fiber-core-num?   uint32
    |  |  +--ro fiber-type?       identityref
    |  |  +--ro attenuation?      decimal64
    |  +--ro child-cable* [index]
    |     +--ro index     uint8
    |     +--ro id?       string
    |     +--ro length?   uint32
    |     +--ro a-end
    |     |  +--ro device-type?           identityref
    |     |  +--ro (connected-device-type)?
    |     |     +--:(passive)
    |     |     |  +--ro device-id?       string
    |     |     +--:(active)
    |     |        +--ro ne-ref?          leafref
    |     |        +--ro component-ref?   leafref
    |     +--ro z-end
    |        +--ro device-type?           identityref
    |        +--ro (connected-device-type)?
    |           +--:(passive)
    |           |  +--ro device-id?       string
    |           +--:(active)
    |              +--ro ne-ref?          leafref
    |              +--ro component-ref?   leafref
    +--ro passive-device* [id]
       +--ro id              string
       +--ro uuid?           yang:uuid
       +--ro name?           string
       +--ro alias?          string
       +--ro description?    string
       +--ro device-type?    identityref
       +--ro custom-tags*    string
       +--ro location-ref?   nil:ni-location-ref
       +--ro passive-port* [id]
          +--ro id                string
          +--ro uuid?             yang:uuid
          +--ro name?             string
          +--ro alias?            string
          +--ro description?      string
          +--ro port-type?        identityref
          +--ro fiber-core-num?   uint32

  grouping connected-device-end:
    +-- device-type?           identityref
    +-- (connected-device-type)?
       +--:(passive)
       |  +-- device-id?       string
       +--:(active)
          +-- ne-ref?          leafref
          +-- component-ref?   leafref
  grouping connected-device-ref:
    +-- a-end
    |  +-- device-type?           identityref
    |  +-- (connected-device-type)?
    |     +--:(passive)
    |     |  +-- device-id?       string
    |     +--:(active)
    |        +-- ne-ref?          leafref
    |        +-- component-ref?   leafref
    +-- z-end
       +-- device-type?           identityref
       +-- (connected-device-type)?
          +--:(passive)
          |  +-- device-id?       string
          +--:(active)
             +-- ne-ref?          leafref
             +-- component-ref?   leafref
  grouping common-cable-attributes:
    +-- id?       string
    +-- length?   uint32
    +-- a-end
    |  +-- device-type?           identityref
    |  +-- (connected-device-type)?
    |     +--:(passive)
    |     |  +-- device-id?       string
    |     +--:(active)
    |        +-- ne-ref?          leafref
    |        +-- component-ref?   leafref
    +-- z-end
       +-- device-type?           identityref
       +-- (connected-device-type)?
          +--:(passive)
          |  +-- device-id?       string
          +--:(active)
             +-- ne-ref?          leafref
             +-- component-ref?   leafref
  grouping optical-cable-attributes:
    +-- optical-cable
       +-- fiber-core-num?   uint32
       +-- fiber-type?       identityref
       +-- attenuation?      decimal64
  grouping cable-attributes:
    +-- id?              string
    +-- length?          uint32
    +-- a-end
    |  +-- device-type?           identityref
    |  +-- (connected-device-type)?
    |     +--:(passive)
    |     |  +-- device-id?       string
    |     +--:(active)
    |        +-- ne-ref?          leafref
    |        +-- component-ref?   leafref
    +-- z-end
    |  +-- device-type?           identityref
    |  +-- (connected-device-type)?
    |     +--:(passive)
    |     |  +-- device-id?       string
    |     +--:(active)
    |        +-- ne-ref?          leafref
    |        +-- component-ref?   leafref
    +-- uuid?            yang:uuid
    +-- name?            string
    +-- alias?           string
    +-- description?     string
    +-- cable-type?      identityref
    +-- cable-role?      identityref
    +-- optical-cable
       +-- fiber-core-num?   uint32
       +-- fiber-type?       identityref
       +-- attenuation?      decimal64
  grouping child-cables:
    +-- child-cable* [index]
       +-- index     uint8
       +-- id?       string
       +-- length?   uint32
       +-- a-end
       |  +-- device-type?           identityref
       |  +-- (connected-device-type)?
       |     +--:(passive)
       |     |  +-- device-id?       string
       |     +--:(active)
       |        +-- ne-ref?          leafref
       |        +-- component-ref?   leafref
       +-- z-end
          +-- device-type?           identityref
          +-- (connected-device-type)?
             +--:(passive)
             |  +-- device-id?       string
             +--:(active)
                +-- ne-ref?          leafref
                +-- component-ref?   leafref
  grouping cables:
    +-- cable* [id]
       +-- id?              string
       +-- length?          uint32
       +-- a-end
       |  +-- device-type?           identityref
       |  +-- (connected-device-type)?
       |     +--:(passive)
       |     |  +-- device-id?       string
       |     +--:(active)
       |        +-- ne-ref?          leafref
       |        +-- component-ref?   leafref
       +-- z-end
       |  +-- device-type?           identityref
       |  +-- (connected-device-type)?
       |     +--:(passive)
       |     |  +-- device-id?       string
       |     +--:(active)
       |        +-- ne-ref?          leafref
       |        +-- component-ref?   leafref
       +-- uuid?            yang:uuid
       +-- name?            string
       +-- alias?           string
       +-- description?     string
       +-- cable-type?      identityref
       +-- cable-role?      identityref
       +-- optical-cable
       |  +-- fiber-core-num?   uint32
       |  +-- fiber-type?       identityref
       |  +-- attenuation?      decimal64
       +-- child-cable* [index]
          +-- index     uint8
          +-- id?       string
          +-- length?   uint32
          +-- a-end
          |  +-- device-type?           identityref
          |  +-- (connected-device-type)?
          |     +--:(passive)
          |     |  +-- device-id?       string
          |     +--:(active)
          |        +-- ne-ref?          leafref
          |        +-- component-ref?   leafref
          +-- z-end
             +-- device-type?           identityref
             +-- (connected-device-type)?
                +--:(passive)
                |  +-- device-id?       string
                +--:(active)
                   +-- ne-ref?          leafref
                   +-- component-ref?   leafref
  grouping passive-device-ports:
    +-- passive-port* [id]
       +-- id                string
       +-- uuid?             yang:uuid
       +-- name?             string
       +-- alias?            string
       +-- description?      string
       +-- port-type?        identityref
       +-- fiber-core-num?   uint32
  grouping passive-devices:
    +-- passive-device* [id]
       +-- id              string
       +-- uuid?           yang:uuid
       +-- name?           string
       +-- alias?          string
       +-- description?    string
       +-- device-type?    identityref
       +-- custom-tags*    string
       +-- location-ref?   nil:ni-location-ref
       +-- passive-port* [id]
          +-- id                string
          +-- uuid?             yang:uuid
          +-- name?             string
          +-- alias?            string
          +-- description?      string
          +-- port-type?        identityref
          +-- fiber-core-num?   uint32
